# Copy this file to .env.docker (gitignored) and uncomment/fill the values you
# need. Docker Compose loads .env.docker automatically (see env_file in
# docker-compose.yml); nothing else reads this example file.

# --- GitHub access (optional) ------------------------------------------------
# Fine-grained PAT, created at:
#   GitHub -> Settings -> Developer settings -> Personal access tokens ->
#   Fine-grained tokens
#   Resource owner:    your account
#   Repository access: Only select repositories -> your private fork
#   Permissions:       Contents: Read and write
#                      Metadata: Read (added automatically)
#   Expiration:        90 days or less
# gh reads GH_TOKEN from the environment; the entrypoint derives git's
# credential helper from it (gh auth setup-git).
#GH_TOKEN=github_pat_replace_me

# --- Commit identity for agent-created commits -------------------------------
# The GitHub noreply address avoids publishing a real email.
#GIT_USER_NAME=Your Name
#GIT_USER_EMAIL=you@users.noreply.github.com

# --- Model service selection -------------------------------------------------
# The agent TUI defaults to DeepSeek Flash (cloud) through the `deepseek`
# registry entry. Set the API key to use it:
#MODEL_API_KEY=sk-replace_me
#
# Optional overrides (the defaults are shown):
#MODEL_SERVICE=deepseek
#MODEL_NAME=deepseek-flash
#OPENCODE_MODEL=deepseek/deepseek-flash
#
# Local LM Studio alternative (no API key):
#MODEL_SERVICE=lmstudio
#MODEL_NAME=qwen/qwen3.5-9b
#MODEL_PORT=1234
#MODEL_BASE_URL=http://host.docker.internal:1234/v1

# --- hh.ru API (optional; needed by the hhru-search portal CLI) --------------
# Access token for https://dev.hh.ru (application or user token). hh.ru rejects
# anonymous vacancy search with HTTP 403 captcha, so /scrape's hhru-search skill
# needs this. HH_USER_AGENT is sent as both User-Agent and HH-User-Agent and
# should name the app plus a contact email. Recreate the container after editing.
#HH_API_TOKEN=replace_me
#HH_USER_AGENT=hhru-search-cli/1.0 (you@example.com)

# --- hh.ru auto-apply (/submit) ---------------------------------------------
# /submit drives the vacancy response form with Playwright under your saved
# hh.ru session (state/hh_storage_state.json, gitignored). Run the one-time
# login on a machine with a display, then the container reuses the cookies:
#   python tools/hh_apply.py login   (or `make login` from the repo root)
# Refresh it any time with /submit-login in the chat; `login --from <path>`
# imports an existing Playwright storage_state.json.
# Choose which hh.ru resume to send. With neither set the driver uses the only
# active resume; if several exist it stops and asks you to pick one.
#HH_RESUME_TITLE=ML Engineer
#HH_RESUME_ID=
# Optional timing/behaviour overrides.
#HH_HEADLESS=1
#HH_TIMEOUT_MS=30000
#HH_DELAY_MS=1500
# How many seconds `login` waits for the sign-in to finish (default 300).
#HH_LOGIN_TIMEOUT=300

# --- Telegram bot (optional) -------------------------------------------------
# 1. Create a bot with @BotFather (https://t.me/BotFather) and paste its token.
# 2. TELEGRAM_ALLOWED_USER_ID is YOUR numeric Telegram user id (not @username):
#    message @userinfobot, or press /start in your bot and read the id it
#    replies with. Comma-separated for several people.
# Answers run headlessly through the agent; a question/draft audit lands in the
# telegram-home volume. See DOCKER.md, "Telegram bot".
#TELEGRAM_BOT_TOKEN=123456:replace_me
#TELEGRAM_ALLOWED_USER_ID=123456789
#TELEGRAM_MAX_ANSWERS_PER_HOUR=30
#TELEGRAM_MAX_VACANCIES_PER_HOUR=5
# Answer timeout in seconds. Unset or 0 waits indefinitely; a positive value
# caps one answer (useful with slow local models during interviews).
#TELEGRAM_ANSWER_TIMEOUT=0
# Bot-only model overrides (fall back to MODEL_* above). The default is
# DeepSeek Flash for both; override here to give the bot a different model.
#TELEGRAM_MODEL_SERVICE=deepseek
#TELEGRAM_MODEL_NAME=deepseek-flash
#TELEGRAM_MODEL_API_KEY=sk-replace_me

# --- Local test runs ---------------------------------------------------------
# After /setup personalizes the profile, the upstream placeholder-integrity
# tests (tests/test_placeholder_integrity.py) only skip when
# GITHUB_REPOSITORY is not the upstream template repo. Set this to your fork
# so `make test` stays green locally; GitHub CI sets it automatically.
#GITHUB_REPOSITORY=your-user/ai-job-search
